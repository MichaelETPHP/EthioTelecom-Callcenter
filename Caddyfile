# sms.ethiotelecom.zmichael.click exists solely because the Android SMS
# Gateway app's own "API URL" setting only accepts a bare origin
# (scheme+host, no path) - saving any URL with a path segment (like the
# /sms-api prefix the main domain uses) gets silently truncated back down
# to just "https://host:443" by the app itself, so it can never be pointed
# at a path-prefixed deployment. This subdomain gives it a path-free root
# to register against instead. Split into its own explicit-hostname block
# (rather than the bare, host-agnostic :80 block below) so it can behave
# differently from the main domain sharing this same Caddy container.
sms.ethiotelecom.zmichael.click:80 {
	# health and the api-catalog are mounted at the Go app's true root
	# (AsRootHandler, see module.go) - unlike the mobile/3rdparty routes
	# below, these must NOT get /api prepended, or they 404.
	handle /health {
		header Cache-Control "no-store"
		reverse_proxy sms-gateway-backend:3000
	}

	handle /.well-known/api-catalog {
		reverse_proxy sms-gateway-backend:3000
	}

	# Everything else (mobile/v1/*, 3rdparty/v1/*, etc.) is mounted at the
	# literal /api prefix internally regardless of HTTP__API__PATH (see
	# internal/sms-gateway/handlers/root.go) - so it still needs /api
	# prepended before reaching the backend, even at this domain's root.
	handle {
		rewrite * /api{uri}
		reverse_proxy sms-gateway-backend:3000
	}
}

:80 {
	# Plain HTTP, no automatic HTTPS here - Coolify's own Traefik proxy
	# in front of this container already terminates TLS for
	# ethiotelecom.zmichael.click and forwards decrypted HTTP here. This
	# block matches any Host header other than sms.ethiotelecom.zmichael.click
	# (claimed by the explicit block above) since Traefik already decided
	# this container is the right target before the request arrives.

	# Public readiness check: preserve the backend's JSON and HTTP status.
	# /health returns 503 when a dependency fails; proxy failures return 502.
	handle /health {
		header Cache-Control "no-store"
		reverse_proxy sms-gateway-backend:3000
	}

	# RFC 9727 API-catalog discovery - the Go app mounts this literally at
	# its own root (see internal/sms-gateway/handlers/api_catalog.go's
	# app.Group("/.well-known/api-catalog", ...)), unprefixed, and every
	# response's Link header points clients here to discover the real API
	# paths before registering. With no rule for it at all, Caddy fell
	# through unmatched and answered with a fake "200 OK, empty body"
	# instead of a 404 or the real catalog JSON - a client relying on this
	# for discovery (rather than a hardcoded path) would get an unparseable
	# empty response and could silently fail before ever attempting device
	# registration. No rewrite needed - same path internally and externally.
	handle /.well-known/api-catalog {
		reverse_proxy sms-gateway-backend:3000
	}

	# Bare /call (no trailing slash) must redirect to /call/ first - the
	# frontend's JS uses relative fetch("api/...") calls that only resolve
	# correctly when the browser's current path ends in /.
	redir /call /call/

	# Strip the /call prefix before forwarding to the Flask app (which
	# thinks it lives at /), but tell it the prefix via header so
	# url_for()-generated links still come out as /call/... (see
	# ProxyFix in call/app.py).
	handle_path /call/* {
		reverse_proxy call:5000 {
			header_up X-Forwarded-Prefix /call
		}
	}

	# HTTP__API__PATH=/sms-api only affects the Go server's own OpenAPI
	# metadata and its outgoing Location-header rewriting - the app's
	# actual routes are always mounted at the literal /api prefix
	# internally (see internal/sms-gateway/handlers/root.go, which checks
	# c.Path() == "/api" verbatim). So /sms-api must be stripped and
	# swapped for /api before reaching the backend, or every request
	# 404s - confirmed live: /sms-api/3rdparty/v1/health/live -> 404,
	# /api/3rdparty/v1/health/live -> 200.
	handle_path /sms-api/* {
		rewrite * /api{uri}
		reverse_proxy sms-gateway-backend:3000
	}

	# Convenience: visiting the bare domain goes to the call center console.
	redir / /call/
}
